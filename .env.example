# ──────────────────────────────────────────────────────────────────────────
# ContenedorApp — variables de entorno
# Copiá este archivo a `.env.local` (NO se commitea). Todas las claves de acá
# son PÚBLICAS (publishable / anon, protegidas por RLS en Supabase): es seguro
# exponerlas en el bundle del cliente. Los secretos de verdad (service role,
# webhook secret) van SOLO en el panel de Supabase Edge Functions, nunca acá.
#
# Si no definís estas variables, la app cae a los valores por defecto
# hardcodeados (el proyecto Supabase actual), así que el deploy existente sigue
# funcionando sin tocar nada. Para apuntar a OTRO proyecto Supabase, definilas.
# ──────────────────────────────────────────────────────────────────────────

# Frontend (Vite expone sólo las que empiezan con VITE_)
VITE_SUPABASE_URL=https://yxfpkxvrzypueusyueuh.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_4Fn3E1cA-quyFvsMHnMfVw_xzrRSbSp

# Serverless cron /api/ping (NO lleva prefijo VITE_; se setea en Vercel)
SUPABASE_ANON_KEY=sb_publishable_4Fn3E1cA-quyFvsMHnMfVw_xzrRSbSp

# Observabilidad (opcional). Si se define, queda listo para integrar Sentry u
# otro proveedor vía src/lib/telemetry.js. Vacío = telemetría no-op.
VITE_SENTRY_DSN=

# ── Edge Function `lemon-webhook` (se setean en Supabase, NO en el cliente) ──
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# LEMON_WEBHOOK_SECRET=
